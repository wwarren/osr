# Everything in this repo runs on Linux (Proxmox hosts, LXC guests). Force LF
# in the working tree on every platform, including Windows checkouts with
# core.autocrlf=true: a CRLF bash script fails with "$'\r': command not found".
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
*.service text eol=lf
*.ini     text eol=lf
*.env     text eol=lf
*.yaml    text eol=lf
*.md      text eol=lf

*.gguf    binary
*.png     binary
