# Non-secret settings only. GITEA_DEPLOY_TOKEN and MATTERMOST_WEBHOOK_URL live in
# /app/router/secrets.env inside the container (never in this repo); set them
# with: manage-model-servers set-token / set-webhook <url>
GITEA_SERVER_URL=https://192.168.11.83
GITEA_ADMIN_USER=ollama-bot
GITEA_VERIFY_TLS=false
MATTERMOST_MONITOR_USER=OllamaMonitor
MATTERMOST_CHANNEL=ollama-monitor
MATTERMOST_VERIFY_TLS=true
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_URL=http://127.0.0.1:4000/v1/chat/completions
LITELLM_HEALTH_URL=http://127.0.0.1:4000/health
# Explicit cloud models (provider model IDs, comma-separated). API keys live in
# /app/router/secrets.env; use manage-model-servers set-cloud-key to set them.
# Empty lists keep cloud providers disabled. They are never used by auto routing.
CLOUD_OPENAI_MODELS=
CLOUD_ANTHROPIC_MODELS=
CLOUD_GEMINI_MODELS=
# Optional separate, current LiteLLM gateway for signed-in Codex/Claude Code
# subscription clients. Use its root URL (HTTPS, or local loopback HTTP).
SUBSCRIPTION_GATEWAY_BASE_URL=
BACKEND_FAST=http://192.168.11.15:11434
BACKEND_MEDIUM=http://192.168.11.14:11434
BACKEND_LARGE=http://192.168.10.59:11434
BACKEND_XLARGE=
MODEL_SERVER_COUNT=3
MODEL_SERVERS=http://192.168.11.15:11434,http://192.168.11.14:11434,http://192.168.10.59:11434
MODEL_FAST=qwen2.5-coder
MODEL_MEDIUM=qwen3.6:35b
MODEL_LARGE=qwen3.8:27b
MODEL_XLARGE=
OLLAMA_KEEP_ALIVE=
KEEP_ALIVE_REFRESH_SECONDS=240
TORCH_CPU_ONLY=true
MONITOR_INTERVAL_SECONDS=15
