[Unit]
Description=Honcho MCP HTTP server (loopback; clients reach it through honcho-gateway)
After=honcho-api.service
Requires=honcho-api.service

[Service]
User=honcho
Group=honcho
WorkingDirectory=/opt/honcho/mcp
Environment=HOME=/var/lib/honcho
Environment=HOST=127.0.0.1
Environment=PORT=3010
Environment=HONCHO_API_URL=http://127.0.0.1:8010
ExecStart=/opt/honcho-bun/bun run http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/honcho /opt/honcho
UMask=0077

[Install]
WantedBy=multi-user.target
