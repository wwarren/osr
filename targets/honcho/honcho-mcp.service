[Unit]
Description=Honcho MCP HTTP server
After=honcho-api.service
Requires=honcho-api.service

[Service]
User=honcho
Group=honcho
WorkingDirectory=/opt/honcho/mcp
Environment=HOME=/var/lib/honcho
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=HONCHO_API_URL=http://127.0.0.1:8000
ExecStart=/opt/honcho-bun/bun run http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/honcho /opt/honcho
UMask=0077

[Install]
WantedBy=multi-user.target
