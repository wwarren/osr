# Installed to /etc/llama-target/llama-server.env (systemd EnvironmentFile syntax).
# Keep MODEL_PATH and MODEL_ALIAS identical in bridge.env.
MODEL_PATH=/var/lib/llama-target/models/model.gguf
MODEL_ALIAS=model:tag
# Total context across all slots; start with one slot to size memory safely.
CONTEXT_SIZE=8192
PARALLEL_SLOTS=1
THREADS=4
# CUDA: request all model layers. Reduce if weights plus KV cache do not fit VRAM.
# A deliberate CPU build must use 0.
GPU_LAYERS=999
# Extra llama-server flags, split on spaces. Examples:
#   --flash-attn on --cache-type-k q8_0 --cache-type-v q8_0
LLAMA_EXTRA_ARGS=
