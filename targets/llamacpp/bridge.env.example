# Installed to /etc/llama-target/bridge.env (systemd EnvironmentFile syntax).
LLAMA_BASE_URL=http://127.0.0.1:8081
# Match the exact router model tag, llama-server alias, and local GGUF file.
MODEL_ALIAS=model:tag
MODEL_PATH=/var/lib/llama-target/models/model.gguf
# Leave blank (or "unknown") to report llama-server's own parameter count.
MODEL_PARAMETER_SIZE=8B
MODEL_FAMILY=llama
MODEL_QUANTIZATION=Q4_K_M
# Advertise only features supported by the selected GGUF/chat template. Add
# tools when the template supports tool calls (llama-server runs with --jinja):
# the router sends tool requests only to models that advertise it.
MODEL_CAPABILITIES=completion
REQUEST_TIMEOUT_SECONDS=600
