# /etc/airllm-target/airllm.env (root:airllm-target 0640). install-target.sh
# creates it from this file; edit it and `systemctl restart airllm-ollama-api`.
# Every value shown is the default unless noted.

# --- Model ---------------------------------------------------------------------
# Hugging Face repo AirLLM loads. A 72B needs ~145 GB to download plus about the
# same again for AirLLM's per-layer shards; start with a small model to test.
AIRLLM_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
# Name clients and the router see. Empty uses AIRLLM_MODEL_ID.
AIRLLM_MODEL_ALIAS=
# Reported metadata. Empty: family from the model config, size from the repo name.
AIRLLM_MODEL_FAMILY=
AIRLLM_MODEL_PARAMETER_SIZE=
# Gated repos (Llama 3) need a read token. It stays in this file only.
HF_TOKEN=

# --- Runtime -------------------------------------------------------------------
# cpu streams layers through RAM; cuda:0 streams them through the GPU.
# install-target.sh picks cuda:0 when nvidia-smi sees a GPU.
AIRLLM_DEVICE=cpu
# 4bit or 8bit (bitsandbytes, installed by the lock). Empty = no compression.
AIRLLM_COMPRESSION=
# Context window: prompt plus reply never exceed this. Longer prompts lose
# their OLDEST tokens; the reply keeps up to half the window.
AIRLLM_MAX_SEQ_LEN=2048
AIRLLM_MAX_NEW_TOKENS=256
# Seconds to wait for a single token. Streaming a 70B on CPU can take minutes.
AIRLLM_TOKEN_TIMEOUT=1800
AIRLLM_PREFETCHING=true

# --- Storage (keep these under /var/lib/airllm-target: the only writable path) --
HF_HOME=/var/lib/airllm-target/hf-cache
AIRLLM_LAYER_SHARDS_PATH=/var/lib/airllm-target/shards
# Delete the downloaded checkpoint after it is split, reclaiming ~half the disk.
AIRLLM_DELETE_ORIGINAL=false

# --- Server --------------------------------------------------------------------
# All interfaces, like the llama.cpp bridge, so the router can reach it. There
# is no authentication: keep the target on an isolated network or firewall the
# port to the router's address.
AIRLLM_HOST=0.0.0.0
AIRLLM_PORT=11434
# Load at boot instead of on the first request.
AIRLLM_EAGER_LOAD=true
# Seconds a request waits on a still-loading model before 503.
AIRLLM_LOAD_WAIT=30
# Exit when loading fails so systemd retries and then marks the unit failed.
AIRLLM_EXIT_ON_LOAD_FAILURE=true
AIRLLM_OLLAMA_VERSION=0.32.15
AIRLLM_LOG_LEVEL=INFO
