# Settings for comfyui.service (a systemd EnvironmentFile: KEY=value, no shell
# syntax). Change them, then: systemctl restart comfyui.service
#
# Address and port ComfyUI listens on. The CT firewall written by
# provision-lxc.sh admits this port from the router only; change both together.
COMFYUI_LISTEN=0.0.0.0
COMFYUI_PORT=8188
# Further ComfyUI options, split on spaces, e.g. --cpu (no GPU; very slow),
# --lowvram, --reserve-vram 1.0, --preview-method auto, --disable-all-custom-nodes.
# See: /opt/comfyui-target/current/venv/bin/python /opt/comfyui-target/current/main.py --help
COMFYUI_EXTRA_ARGS=
