# /etc/ollama-target/ollama.env (root:ollama-target 0640). install-target.sh
# creates it from this file; edit it and `systemctl restart ollama`.
# Documented Ollama server variables only; unset ones use Ollama's defaults.

# All interfaces, like the other targets, so the router can reach it. Ollama
# has no authentication: keep the target on an isolated network or firewall
# TCP 11434 to the router's address.
OLLAMA_HOST=0.0.0.0:11434
# Models live on the only writable path of the hardened unit.
OLLAMA_MODELS=/var/lib/ollama-target/models
# How long an idle model stays loaded. The router's monitor also pins tier
# models with OLLAMA_KEEP_ALIVE from the router side.
OLLAMA_KEEP_ALIVE=30m
# Parallel requests per model and models kept loaded at once. Raise only when
# VRAM/RAM allows; every slot multiplies the KV cache.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Default context window when a request does not set num_ctx.
OLLAMA_CONTEXT_LENGTH=8192
# Flash attention and a quantized KV cache (f16, q8_0, q4_0) save VRAM.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=f16
